# Copy this file to .env for local development. Do not commit the copied file.
VITE_VERSION=3.0.2
VITE_PORT=3006
VITE_BASE_URL=/
VITE_ACCESS_MODE=frontend
VITE_WITH_CREDENTIALS=false
VITE_OPEN_ROUTE_INFO=false
VITE_LOCK_ENCRYPT_KEY=replace-with-a-local-value
VITE_API_URL=/
VITE_API_PROXY_URL=http://127.0.0.1:3000
VITE_DROP_CONSOLE=false
