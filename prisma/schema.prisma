// 业务状态 CHECK、部分唯一索引和跨表不变量仍需在迁移与服务端事务中落实。
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String               @id @default(uuid()) @db.Uuid
  wechatOpenid     String               @unique @map("wechat_openid") @db.VarChar(128)
  status           String               @db.VarChar(16)
  deletedAt        DateTime?            @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions         UserSession[]
  consents         UserConsent[]
  orders           Order[]
  refunds          Refund[]
  generationJobs   GenerationJob[]
  savedContents    SavedContent[]
  creditBatches    CreditBatch[]
  reservations     CreditReservation[]
  creditLedger     CreditLedger[]
  dailyUsage       UserDailyUsage[]

  @@map("users")
}

model UserSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("user_sessions")
}

model UserConsent {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  documentType    String   @map("document_type") @db.VarChar(32)
  documentVersion String   @map("document_version") @db.VarChar(32)
  acceptedAt      DateTime @map("accepted_at") @db.Timestamptz(6)
  source          String   @db.VarChar(32)
  user            User     @relation(fields: [userId], references: [id])

  @@unique([userId, documentType, documentVersion])
  @@map("user_consents")
}

model AdminUser {
  id                  String            @id @default(uuid()) @db.Uuid
  username            String            @unique @db.VarChar(80)
  nickname            String?           @db.VarChar(80)
  realName            String?           @map("real_name") @db.VarChar(80)
  gender              String?           @db.VarChar(8)
  phone               String?           @db.VarChar(20)
  email               String?           @db.VarChar(254)
  department          String?           @db.VarChar(80)
  avatarKey           String?           @map("avatar_key") @db.VarChar(20)
  address             String?           @db.VarChar(200)
  bio                 String?           @db.VarChar(500)
  createdBy           String?           @map("created_by") @db.Uuid
  updatedBy           String?           @map("updated_by") @db.Uuid
  passwordHash        String            @map("password_hash") @db.Text
  mfaSecretCiphertext String            @map("mfa_secret_ciphertext") @db.Text
  role                String            @db.VarChar(24)
  status              String            @db.VarChar(16)
  lastLoginAt         DateTime?         @map("last_login_at") @db.Timestamptz(6)
  lastTotpStep        BigInt?           @map("last_totp_step")
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  publishedVersions   TemplateVersion[] @relation("PublishedTemplateVersion")
  updatedTemplates    Template[]        @relation("UpdatedTemplate")
  reviewedRefunds     Refund[]          @relation("ReviewedRefund")
  auditLogs           AdminAuditLog[]
  sessions            AdminSession[]

  @@map("admin_users")
}

model AdminSession {
  id          String    @id @default(uuid()) @db.Uuid
  adminUserId String    @map("admin_user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId])
  @@map("admin_sessions")
}

model AdminLoginLimit {
  key         String    @id @db.Char(64)
  attempts    Int       @default(0)
  windowStart DateTime  @map("window_start") @db.Timestamptz(6)
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(6)
  updatedAt   DateTime  @map("updated_at") @db.Timestamptz(6)

  @@map("admin_login_limits")
}

model Template {
  id               String           @id @default(uuid()) @db.Uuid
  code             String           @unique @db.VarChar(40)
  name             String           @db.VarChar(80)
  category         String           @db.VarChar(32)
  description      String           @db.VarChar(500)
  status           String           @db.VarChar(16)
  sortOrder        Int              @map("sort_order")
  currentVersionId String?          @unique @map("current_version_id") @db.Uuid
  updatedBy        String?          @map("updated_by") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  versions         TemplateVersion[] @relation("TemplateVersions")
  currentVersion   TemplateVersion? @relation("CurrentTemplateVersion", fields: [currentVersionId], references: [id])
  updatedByAdmin   AdminUser?       @relation("UpdatedTemplate", fields: [updatedBy], references: [id], onDelete: SetNull)
  generationJobs   GenerationJob[]

  @@map("templates")
}

model TemplateVersion {
  id                  String     @id @default(uuid()) @db.Uuid
  templateId          String     @map("template_id") @db.Uuid
  version             Int
  status              String     @db.VarChar(16)
  formSchema          Json       @map("form_schema") @db.JsonB
  outputSchema        Json       @map("output_schema") @db.JsonB
  systemPromptVersion String     @map("system_prompt_version") @db.VarChar(40)
  developerPrompt     String     @map("developer_prompt") @db.Text
  modelConfig         Json       @map("model_config") @db.JsonB
  changeLog           String     @map("change_log") @db.Text
  publishedBy         String?    @map("published_by") @db.Uuid
  publishedAt         DateTime?  @map("published_at") @db.Timestamptz(6)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  template            Template   @relation("TemplateVersions", fields: [templateId], references: [id])
  currentForTemplate  Template?  @relation("CurrentTemplateVersion")
  publisher           AdminUser? @relation("PublishedTemplateVersion", fields: [publishedBy], references: [id])
  generationJobs      GenerationJob[]

  @@unique([templateId, version])
  @@map("template_versions")
}

model Plan {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(40)
  name      String   @db.VarChar(80)
  priceFen  BigInt   @map("price_fen")
  credits   Int
  validDays Int?     @map("valid_days")
  status    String   @db.VarChar(16)
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  orders    Order[]

  @@map("plans")
}

model Order {
  id                String         @id @default(uuid()) @db.Uuid
  userId            String         @map("user_id") @db.Uuid
  planId            String         @map("plan_id") @db.Uuid
  clientRequestId   String         @map("client_request_id") @db.VarChar(80)
  requestHash       String         @map("request_hash") @db.Char(64)
  merchantOrderNo   String         @unique @map("merchant_order_no") @db.VarChar(64)
  planNameSnapshot  String         @map("plan_name_snapshot") @db.VarChar(80)
  priceFen          BigInt         @map("price_fen")
  creditsSnapshot   Int            @map("credits_snapshot")
  validDaysSnapshot Int?           @map("valid_days_snapshot")
  status            String         @db.VarChar(16)
  wechatTransactionId String?      @unique @map("wechat_transaction_id") @db.VarChar(64)
  paidAt            DateTime?      @map("paid_at") @db.Timestamptz(6)
  closedAt          DateTime?      @map("closed_at") @db.Timestamptz(6)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              User           @relation(fields: [userId], references: [id])
  plan              Plan           @relation(fields: [planId], references: [id])
  refunds           Refund[]
  paymentEvents     PaymentEvent[]
  creditBatch       CreditBatch?
  creditLedger      CreditLedger[]

  @@unique([userId, clientRequestId])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("orders")
}

model Refund {
  id               String         @id @default(uuid()) @db.Uuid
  orderId          String         @map("order_id") @db.Uuid
  userId           String         @map("user_id") @db.Uuid
  clientRequestId  String         @map("client_request_id") @db.VarChar(80)
  merchantRefundNo String         @unique @map("merchant_refund_no") @db.VarChar(64)
  wechatRefundId   String?        @map("wechat_refund_id") @db.VarChar(64)
  amountFen        BigInt         @map("amount_fen")
  status           String         @db.VarChar(16)
  reason           String         @db.VarChar(500)
  reviewNote       String?        @map("review_note") @db.VarChar(500)
  reviewedBy       String?        @map("reviewed_by") @db.Uuid
  reviewedAt       DateTime?      @map("reviewed_at") @db.Timestamptz(6)
  finishedAt       DateTime?      @map("finished_at") @db.Timestamptz(6)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  order            Order          @relation(fields: [orderId], references: [id])
  user             User           @relation(fields: [userId], references: [id])
  reviewer         AdminUser?     @relation("ReviewedRefund", fields: [reviewedBy], references: [id])
  paymentEvents    PaymentEvent[]
  creditLedger     CreditLedger[]

  @@unique([userId, clientRequestId])
  @@index([orderId])
  @@map("refunds")
}

model PaymentEvent {
  id               String    @id @default(uuid()) @db.Uuid
  provider         String    @db.VarChar(16)
  providerEventId  String    @map("provider_event_id") @db.VarChar(80)
  eventType        String    @map("event_type") @db.VarChar(32)
  orderId          String?   @map("order_id") @db.Uuid
  refundId         String?   @map("refund_id") @db.Uuid
  transactionRef   String    @map("transaction_ref") @db.VarChar(80)
  payloadSha256    String    @map("payload_sha256") @db.Char(64)
  verifiedPayload  Json      @map("verified_payload") @db.JsonB
  processingStatus String    @map("processing_status") @db.VarChar(16)
  receivedAt       DateTime  @map("received_at") @db.Timestamptz(6)
  processedAt      DateTime? @map("processed_at") @db.Timestamptz(6)
  lastError        String?   @map("last_error") @db.VarChar(500)
  order            Order?    @relation(fields: [orderId], references: [id])
  refund           Refund?   @relation(fields: [refundId], references: [id])

  @@unique([provider, providerEventId])
  @@index([processingStatus, receivedAt])
  @@map("payment_events")
}

model GenerationJob {
  id                String             @id @default(uuid()) @db.Uuid
  userId            String             @map("user_id") @db.Uuid
  templateId        String             @map("template_id") @db.Uuid
  templateVersionId String             @map("template_version_id") @db.Uuid
  clientRequestId   String             @map("client_request_id") @db.VarChar(80)
  requestHash       String             @map("request_hash") @db.Char(64)
  inputData         Json               @map("input_data") @db.JsonB
  resultData        Json?              @map("result_data") @db.JsonB
  schemaVersion     String             @map("schema_version") @db.VarChar(32)
  status            String             @db.VarChar(16)
  quotaDay          DateTime           @map("quota_day") @db.Date
  processingToken   String?            @map("processing_token") @db.Uuid
  leaseUntil        DateTime?          @map("lease_until") @db.Timestamptz(6)
  attemptCount      Int                @map("attempt_count")
  deadlineAt        DateTime           @map("deadline_at") @db.Timestamptz(6)
  previewText       String?            @map("preview_text") @db.VarChar(240)
  errorCode         String?            @map("error_code") @db.VarChar(64)
  deletedAt         DateTime?          @map("deleted_at") @db.Timestamptz(6)
  contentPurgedAt   DateTime?          @map("content_purged_at") @db.Timestamptz(6)
  startedAt         DateTime?          @map("started_at") @db.Timestamptz(6)
  completedAt       DateTime?          @map("completed_at") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              User               @relation(fields: [userId], references: [id])
  template          Template           @relation(fields: [templateId], references: [id])
  templateVersion   TemplateVersion    @relation(fields: [templateVersionId], references: [id])
  attempts          GenerationAttempt[]
  savedContent      SavedContent?
  reservation       CreditReservation?

  @@unique([userId, clientRequestId])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("generation_jobs")
}

model GenerationAttempt {
  id                String        @id @default(uuid()) @db.Uuid
  jobId             String        @map("job_id") @db.Uuid
  attemptNo         Int           @map("attempt_no")
  provider          String        @db.VarChar(40)
  modelName         String        @map("model_name") @db.VarChar(80)
  providerRequestId String?       @map("provider_request_id") @db.VarChar(160)
  status            String        @db.VarChar(16)
  inputTokens       Int?          @map("input_tokens")
  outputTokens      Int?          @map("output_tokens")
  durationMs        Int?          @map("duration_ms")
  errorCode         String?       @map("error_code") @db.VarChar(64)
  startedAt         DateTime      @map("started_at") @db.Timestamptz(6)
  completedAt       DateTime?     @map("completed_at") @db.Timestamptz(6)
  job               GenerationJob @relation(fields: [jobId], references: [id])

  @@unique([jobId, attemptNo])
  @@map("generation_attempts")
}

model SavedContent {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  generationJobId String        @unique @map("generation_job_id") @db.Uuid
  editedResult    Json?         @map("edited_result") @db.JsonB
  editedText      String?       @map("edited_text") @db.Text
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  user            User          @relation(fields: [userId], references: [id])
  generationJob   GenerationJob @relation(fields: [generationJobId], references: [id])

  @@map("saved_contents")
}

model CreditBatch {
  id           String                        @id @default(uuid()) @db.Uuid
  userId       String                        @map("user_id") @db.Uuid
  orderId      String?                       @unique @map("order_id") @db.Uuid
  sourceType   String                        @map("source_type") @db.VarChar(24)
  sourceRef    String                        @map("source_ref") @db.VarChar(120)
  grantedQty   Int                           @map("granted_qty")
  reservedQty  Int                           @map("reserved_qty")
  consumedQty  Int                           @map("consumed_qty")
  heldQty      Int                           @map("held_qty")
  revokedQty   Int                           @map("revoked_qty")
  expiredQty   Int                           @map("expired_qty")
  effectiveAt  DateTime                      @map("effective_at") @db.Timestamptz(6)
  expiresAt    DateTime?                     @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)
  user         User                          @relation(fields: [userId], references: [id])
  order        Order?                        @relation(fields: [orderId], references: [id])
  allocations  CreditReservationAllocation[]
  ledger       CreditLedger[]

  @@unique([userId, sourceType, sourceRef])
  @@index([userId, expiresAt, createdAt])
  @@map("credit_batches")
}

model CreditReservation {
  id              String                        @id @default(uuid()) @db.Uuid
  userId          String                        @map("user_id") @db.Uuid
  generationJobId String                        @unique @map("generation_job_id") @db.Uuid
  quantity        Int
  status          String                        @db.VarChar(16)
  reservedAt      DateTime                      @map("reserved_at") @db.Timestamptz(6)
  settledAt       DateTime?                     @map("settled_at") @db.Timestamptz(6)
  user            User                          @relation(fields: [userId], references: [id])
  generationJob   GenerationJob                 @relation(fields: [generationJobId], references: [id])
  allocations     CreditReservationAllocation[]
  ledger          CreditLedger[]

  @@map("credit_reservations")
}

model CreditReservationAllocation {
  id            String            @id @default(uuid()) @db.Uuid
  reservationId String            @map("reservation_id") @db.Uuid
  batchId       String            @map("batch_id") @db.Uuid
  quantity      Int
  reservation   CreditReservation @relation(fields: [reservationId], references: [id])
  batch         CreditBatch       @relation(fields: [batchId], references: [id])

  @@unique([reservationId, batchId])
  @@index([batchId])
  @@map("credit_reservation_allocations")
}

model CreditLedger {
  id              String             @id @default(uuid()) @db.Uuid
  userId          String             @map("user_id") @db.Uuid
  batchId         String             @map("batch_id") @db.Uuid
  reservationId   String?            @map("reservation_id") @db.Uuid
  orderId         String?            @map("order_id") @db.Uuid
  refundId        String?            @map("refund_id") @db.Uuid
  eventKey        String             @unique @map("event_key") @db.VarChar(180)
  eventType       String             @map("event_type") @db.VarChar(24)
  deltaGranted    Int                @map("delta_granted")
  deltaReserved   Int                @map("delta_reserved")
  deltaConsumed   Int                @map("delta_consumed")
  deltaHeld       Int                @map("delta_held")
  deltaRevoked    Int                @map("delta_revoked")
  deltaExpired    Int                @map("delta_expired")
  reason          String             @db.VarChar(500)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  user            User               @relation(fields: [userId], references: [id])
  batch           CreditBatch        @relation(fields: [batchId], references: [id])
  reservation     CreditReservation? @relation(fields: [reservationId], references: [id])
  order           Order?             @relation(fields: [orderId], references: [id])
  refund          Refund?            @relation(fields: [refundId], references: [id])

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("credit_ledger")
}

model UserDailyUsage {
  userId       String   @map("user_id") @db.Uuid
  bizDate      DateTime @map("biz_date") @db.Date
  successCount Int      @map("success_count")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id])

  @@id([userId, bizDate])
  @@map("user_daily_usage")
}

model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  eventKey    String    @unique @map("event_key") @db.VarChar(180)
  eventType   String    @map("event_type") @db.VarChar(80)
  aggregateId String    @map("aggregate_id") @db.Uuid
  payload     Json      @db.JsonB
  status      String    @db.VarChar(16)
  availableAt DateTime  @map("available_at") @db.Timestamptz(6)
  attempts    Int
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  lastError   String?   @map("last_error") @db.VarChar(500)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, availableAt, createdAt])
  @@map("outbox_events")
}

model AdminAuditLog {
  id            String    @id @default(uuid()) @db.Uuid
  adminUserId   String    @map("admin_user_id") @db.Uuid
  action        String    @db.VarChar(100)
  resourceType  String    @map("resource_type") @db.VarChar(80)
  resourceId    String    @map("resource_id") @db.VarChar(120)
  requestId     String    @map("request_id") @db.VarChar(100)
  ipHash        String    @map("ip_hash") @db.Char(64)
  changeSummary Json      @map("change_summary") @db.JsonB
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  adminUser     AdminUser @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId, createdAt])
  @@map("admin_audit_logs")
}
