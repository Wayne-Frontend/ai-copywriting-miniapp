# Copy to .env.local in the project root. This file is ignored by Git.
# UTF-8; one KEY=value per line; optional matching quotes around values.
# Keep this file private. Do not put these values in apps/admin/.env.
POSTGRES_PASSWORD=
ADMIN_MFA_KEY=
DASHSCOPE_API_KEY=
# Optional: leave blank to use the Beijing endpoint and qwen-plus.
DASHSCOPE_BASE_URL=
DASHSCOPE_MODEL=
